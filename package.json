{
  "name": "profiles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "dev:http": "next dev --turbopack",
    "build": "prisma generate --no-hints && next build",
    "build:development": "npm run build && npm run db:reset && npm run db:seed && npm run db:seed-samples && npm run db:seed-admin",
    "start": "next start",
    "lint": "next lint",
    "test:storage-connectivity": "tsx tests/test-credentials.ts",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:seed-samples": "tsx prisma/seed-samples.ts",
    "db:seed-admin": "tsx prisma/seed-admin.ts",
    "admin:set": "tsx scripts/set-admin.ts"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.1",
    "@auth/prisma-adapter": "^2.11.1",
    "@google-cloud/storage": "^7.18.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@react-google-maps/api": "^2.20.7",
    "@vercel/speed-insights": "^1.3.1",
    "clsx": "^2.1.1",
    "next": "16.0.10",
    "next-auth": "5.0.0-beta.30",
    "next-intl": "^4.6.0",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-dropzone": "^14.3.5",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.68.0",
    "sharp": "^0.34.5",
    "sonner": "^1.7.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.10",
    "postcss": "^8.5.6",
    "prisma": "^7.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
