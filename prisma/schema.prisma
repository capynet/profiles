datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
  output     = "../node_modules/.prisma/client"
}

model ProfileImage {
  id        Int @id @default(autoincrement())
  profileId Int
  position  Int @default(0)

  // Medium quality version (default)
  mediumUrl        String
  mediumCdnUrl     String?
  mediumStorageKey String

  // Thumbnail version
  thumbnailUrl        String?
  thumbnailCdnUrl     String?
  thumbnailStorageKey String?

  // High quality version
  highQualityUrl        String?
  highQualityCdnUrl     String?
  highQualityStorageKey String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Nationality {
  id               Int                         @id @default(autoincrement())
  name             String                      @unique
  profiles         ProfileNationality[]
  versionSnapshots ProfileVersionNationality[]
}

model Ethnicity {
  id               Int                       @id @default(autoincrement())
  name             String                    @unique
  profiles         ProfileEthnicity[]
  versionSnapshots ProfileVersionEthnicity[]
}

model ProfileNationality {
  profile       Profile     @relation(fields: [profileId], references: [id])
  profileId     Int
  nationality   Nationality @relation(fields: [nationalityId], references: [id])
  nationalityId Int

  @@id([profileId, nationalityId])
}

model ProfileEthnicity {
  profile     Profile   @relation(fields: [profileId], references: [id])
  profileId   Int
  ethnicity   Ethnicity @relation(fields: [ethnicityId], references: [id])
  ethnicityId Int

  @@id([profileId, ethnicityId])
}

// Update the Profile model
model Profile {
  id                Int                    @id @default(autoincrement())
  userId            String // Ya no tiene @unique
  name              String
  price             Float
  age               Int
  description       String
  latitude          Float
  longitude         Float
  address           String
  phone             String?
  hasWhatsapp       Boolean                @default(false)
  hasTelegram       Boolean                @default(false)
  published         Boolean                @default(false)
  isDraft           Boolean                @default(false)
  originalProfileId Int?
  originalProfile   Profile?               @relation("DraftToOriginal", fields: [originalProfileId], references: [id], onDelete: SetNull)
  drafts            Profile[]              @relation("DraftToOriginal")
  currentVersion    Int                    @default(1) // For optimistic locking
  updatedAt         DateTime               @updatedAt
  createdAt         DateTime               @default(now())
  paymentMethods    ProfilePaymentMethod[]
  languages         ProfileLanguage[]
  images            ProfileImage[]
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalities     ProfileNationality[]
  ethnicities       ProfileEthnicity[]
  services          ProfileService[]
  versions          ProfileVersion[] // Version history

  @@index([userId, published, isDraft])
}

model PaymentMethod {
  id               Int                           @id @default(autoincrement())
  name             String                        @unique
  profiles         ProfilePaymentMethod[]
  versionSnapshots ProfileVersionPaymentMethod[]
}

model Language {
  id               Int                      @id @default(autoincrement())
  name             String                   @unique
  profiles         ProfileLanguage[]
  versionSnapshots ProfileVersionLanguage[]
}

model ProfilePaymentMethod {
  profile         Profile       @relation(fields: [profileId], references: [id])
  profileId       Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId Int

  @@id([profileId, paymentMethodId])
}

model ProfileLanguage {
  profile    Profile  @relation(fields: [profileId], references: [id])
  profileId  Int
  language   Language @relation(fields: [languageId], references: [id])
  languageId Int

  @@id([profileId, languageId])
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  role          String          @default("user")
  accounts      Account[]
  sessions      Session[]
  Authenticator Authenticator[]
  profiles      Profile[] // Cambiado de profile Profile? a profiles Profile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Service {
  id               Int                    @id @default(autoincrement())
  name             String                 @unique
  profiles         ProfileService[]
  versionSnapshots ProfileVersionService[]
}

model ProfileService {
  profile   Profile @relation(fields: [profileId], references: [id])
  profileId Int
  service   Service @relation(fields: [serviceId], references: [id])
  serviceId Int

  @@id([profileId, serviceId])
}

// Profile Versioning System

model ProfileVersion {
  id        Int      @id @default(autoincrement())
  profileId Int
  version   Int // Sequential version number for this profile

  // Snapshot of profile data at this point in time
  name        String
  price       Float
  age         Int
  description String
  latitude    Float
  longitude   Float
  address     String
  phone       String?
  hasWhatsapp Boolean
  hasTelegram Boolean
  published   Boolean

  // Audit trail
  createdBy String   // User ID who triggered this version
  createdAt DateTime @default(now())
  comment   String? // Optional comment about what changed

  // Relationships to versioned data
  profile         Profile                       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  images          ProfileVersionImage[]
  languages       ProfileVersionLanguage[]
  paymentMethods  ProfileVersionPaymentMethod[]
  nationalities   ProfileVersionNationality[]
  ethnicities     ProfileVersionEthnicity[]
  services        ProfileVersionService[]

  @@unique([profileId, version])
  @@index([profileId, createdAt])
  @@index([createdBy])
}

model ProfileVersionImage {
  id       Int @id @default(autoincrement())
  versionId Int
  position Int

  // Store the same data as ProfileImage
  mediumUrl        String
  mediumCdnUrl     String?
  mediumStorageKey String

  thumbnailUrl        String?
  thumbnailCdnUrl     String?
  thumbnailStorageKey String?

  highQualityUrl        String?
  highQualityCdnUrl     String?
  highQualityStorageKey String?

  version ProfileVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

model ProfileVersionLanguage {
  versionId  Int
  languageId Int

  version  ProfileVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  language Language       @relation(fields: [languageId], references: [id])

  @@id([versionId, languageId])
}

model ProfileVersionPaymentMethod {
  versionId       Int
  paymentMethodId Int

  version       ProfileVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod  @relation(fields: [paymentMethodId], references: [id])

  @@id([versionId, paymentMethodId])
}

model ProfileVersionNationality {
  versionId     Int
  nationalityId Int

  version     ProfileVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  nationality Nationality    @relation(fields: [nationalityId], references: [id])

  @@id([versionId, nationalityId])
}

model ProfileVersionEthnicity {
  versionId   Int
  ethnicityId Int

  version   ProfileVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  ethnicity Ethnicity      @relation(fields: [ethnicityId], references: [id])

  @@id([versionId, ethnicityId])
}

model ProfileVersionService {
  versionId Int
  serviceId Int

  version ProfileVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id])

  @@id([versionId, serviceId])
}
